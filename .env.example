# OmniGuard — Reactive Omni Buildathon Environment Template
# Copy to .env (git-ignored) and NEVER commit real private keys.

# Deployer EOA private key (0x-prefixed, 64 hex chars). Generate via `npm run wallet:new`.
DEPLOYER_PRIVATE_KEY=

# RPC Endpoints (Official Reactive Omni Testnet Setup)
BASE_SEPOLIA_RPC=https://sepolia.base.org
REACTIVE_LASNA_RPC=https://lasna-rpc.rnk.dev/
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
ETHEREUM_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Official Reactive Omni System & Callback Proxy Addresses (verified against dev.reactive.network)
REACTIVE_SYSTEM_CONTRACT=0x8888888888888888888888888888888888888888
BASE_SEPOLIA_CALLBACK_PROXY=0x476F44b11F5C942c58f4c8E3d0300E5710743585
UNICHAIN_SEPOLIA_CALLBACK_PROXY=0x775c9B990ADe401060B78D0e98684eEf8d2466C1
ETHEREUM_SEPOLIA_CALLBACK_PROXY=0xAa14d9Cd0f788Ca23d11805986C1d8bd035D23b4

# Official lREACT Faucet Bridge Contracts (1 ETH -> 100 lREACT, max 5 ETH/tx)
BASE_SEPOLIA_LREACT_FAUCET=0x2afaFD298b23b62760711756088F75B7409f5967
ETHEREUM_SEPOLIA_LREACT_FAUCET=0x9b9BB25f1A81078C544C829c5EB7822d747Cf434

# Funding amounts used by deploy-live.mjs
REACTIVE_INITIAL_FUND_LREACT=0.5
VAULT_CALLBACK_RESERVE_ETH=0.015

# Populated automatically into deployments/live.json after `npm run deploy:live`
OMNIGUARD_REACTIVE_ADDRESS=
ORIGIN_PRICE_VAULT_ADDRESS=
